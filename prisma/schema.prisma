// ─── Property Access Control ──────────────────────────────────────────────────

model PropertyAccess {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  grantedAt  DateTime @default(now())

  @@unique([userId, propertyId])
}

// ─── Core Models ─────────────────────────────────────────────────────────────

model Property {
  id                   String            @id @default(cuid())
  name                 String
  type                 PropertyType
  category             PropertyCategory?
  categoryOther        String?
  address              String?
  city                 String?
  description          String?
  logoUrl              String?
  // Seeded sample/demo property (stamped by POST /api/demo/seed). Managers may
  // delete demo properties; real property create/delete is admin-only.
  isDemo               Boolean           @default(false)
  organizationId       String?
  organization         Organization?     @relation(fields: [organizationId], references: [id])
  ownerId              String?
  owner                User?             @relation("PropertyOwner", fields: [ownerId], references: [id])
  managerId            String?
  manager              User?             @relation("PropertyManager", fields: [managerId], references: [id])
  managementFeeRate    Float?
  managementFeeFlat    Decimal? @db.Decimal(14, 2)
  serviceChargeDefault Decimal? @db.Decimal(14, 2)
  currency              String            @default("USD")
  vatRegistrationNumber String?
  landlordEntity        String?
  bankName              String?
  bankAccountName       String?
  bankAccountNumber     String?
  units                 Unit[]
  expenses              ExpenseEntry[]
  propertyAccess        PropertyAccess[]
  pettyCash             PettyCash[]
  maintenanceJobs       MaintenanceJob[]
  arrearsCases          ArrearsCase[]
  recurringExpenses     RecurringExpense[]
  insurancePolicies     InsurancePolicy[]
  assets                Asset[]
  agreement             ManagementAgreement?
  conditionReports      BuildingConditionReport[]
  ownerInvoices         OwnerInvoice[]
  checkouts             CheckoutProcess[]
  unitConditionReports  ConditionReport[]
  maintenanceSchedules   AssetMaintenanceSchedule[] @relation("PropertyMaintenanceSchedules")
  taxConfigurations      TaxConfiguration[]
  complianceCertificates ComplianceCertificate[]
  caseThreads            CaseThread[]
  actionableHints        ActionableHint[]
  complaints             TenantComplaint[]
  ownerPayouts           OwnerPayout[]
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
}

// Records that the net-payable for a statement period was actually remitted to
// the property owner. Closes the income -> fee -> payout loop: the calendar's
// RENT_REMITTANCE event becomes verifiable (overdue when past with no payout)
// and owner statements show remitted vs outstanding.
model OwnerPayout {
  id             String         @id @default(cuid())
  propertyId     String
  property       Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  periodYear     Int
  periodMonth    Int // 1-12 — the statement month this payout settles
  amount         Decimal        @db.Decimal(14, 2)
  paidAt         DateTime
  method         PaymentMethod?
  reference      String?
  notes          String?
  createdByEmail String
  createdByName  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([propertyId, periodYear, periodMonth])
}

model Unit {
  id            String                @id @default(cuid())
  unitNumber    String
  propertyId    String
  type          UnitType
  floor         Int?
  sizeSqm       Float?
  monthlyRent   Decimal? @db.Decimal(14, 2)
  status        UnitStatus            @default(ACTIVE)
  vacantSince   DateTime?
  description   String?
  // Domestic Servant Quarter / maid's room attached to the unit — rendered as
  // a "+ DSQ" suffix on the unit-type label (market convention: "3 Bed + DSQ").
  hasDsq        Boolean               @default(false)
  amenities     String[]
  titleReference String?
  // Per-unit override of the property's default payment account — invoices
  // for this unit's tenants show these bank/M-Pesa details instead.
  paymentAccountId String?
  paymentAccount   PaymentAccount?    @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)
  property      Property              @relation(fields: [propertyId], references: [id])
  tenants           Tenant[]
  incomeEntries     IncomeEntry[]
  expenses          ExpenseEntry[]
  feeConfigs        ManagementFeeConfig[]
  maintenanceJobs   MaintenanceJob[]
  recurringExpenses  RecurringExpense[]
  expenseAllocations ExpenseUnitAllocation[]
  assets             Asset[]
  caseThreads        CaseThread[]
  complaints         TenantComplaint[] @relation("ComplaintUnit")
  subjectComplaints  TenantComplaint[] @relation("ComplaintSubjectUnit")
  checkouts          CheckoutProcess[]
  conditionReports   ConditionReport[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([propertyId, unitNumber])
}

model Tenant {
  id               String        @id @default(cuid())
  name             String
  email            String?
  phone            String?
  // Extra reachable people/addresses beyond the primary email/phone —
  // JSON array of { label?, email?, phone? } (spouse, accounts office, etc.)
  additionalContacts Json?
  // Postal address for formal letters (rent demands, notices).
  poBox            String?
  nationalId       String?
  taxIdNumber      String?           @map("kraPinNumber")
  unitId           String
  depositAmount    Decimal @db.Decimal(14, 2)
  depositPaidDate  DateTime?
  leaseStart       DateTime
  leaseEnd         DateTime?
  monthlyRent      Decimal @db.Decimal(14, 2)
  serviceCharge    Decimal         @default(0) @db.Decimal(14, 2)
  rentDueDay       Int           @default(1)
  isActive         Boolean          @default(true)
  vacatedDate      DateTime?
  notes            String?
  renewalStage     RenewalStage     @default(NONE)
  proposedRent     Decimal? @db.Decimal(14, 2)
  proposedLeaseEnd DateTime?
  renewalNotes     String?
  escalationRate   Float?
  // How often the escalation applies, in years (1 = annual, 2 = every two
  // years, or any custom interval). Null = not configured.
  escalationIntervalYears Int?
  chargeLatePenalty Boolean         @default(false)
  isTaxExempt      Boolean         @default(false)
  paymentFrequency PaymentFrequency?
  parkingFee       Decimal? @db.Decimal(14, 2)
  portalToken          String?          @unique
  portalTokenExpiresAt DateTime?
  unit             Unit             @relation(fields: [unitId], references: [id])
  incomeEntries     IncomeEntry[]
  invoices          Invoice[]
  documents         TenantDocument[]
  arrearsCases      ArrearsCase[]
  depositSettlement DepositSettlement?
  checkoutProcess   CheckoutProcess?
  conditionReports  ConditionReport[]
  rentHistory          RentHistory[]
  communicationLogs    CommunicationLog[]
  portalThreads        PortalMessageThread[]
  complaints           TenantComplaint[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([unitId])
  @@index([isActive])
  @@index([unitId, isActive])
  @@index([leaseEnd])
  @@index([portalToken])
}

model RentHistory {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  monthlyRent   Decimal @db.Decimal(14, 2)
  effectiveDate DateTime
  reason        String?
  createdAt     DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, effectiveDate])
}

model IncomeEntry {
  id                String     @id @default(cuid())
  date              DateTime
  checkIn           DateTime?
  checkOut          DateTime?
  unitId            String
  tenantId          String?
  invoiceId         String?
  ownerInvoiceId    String?
  type              IncomeType
  grossAmount       Decimal @db.Decimal(14, 2)
  agentCommission   Decimal      @default(0) @db.Decimal(14, 2)
  commissionPaidAt  DateTime?
  platform          Platform?
  agentName         String?
  nightlyRate       Decimal? @db.Decimal(14, 2)
  note              String?
  taxConfigId       String?
  taxRate           Float?
  taxAmount         Decimal? @db.Decimal(14, 2)
  taxType           TaxType?
  paymentMethod     PaymentMethod?
  unit              Unit         @relation(fields: [unitId], references: [id])
  tenant            Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  invoice           Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  ownerInvoice      OwnerInvoice? @relation(fields: [ownerInvoiceId], references: [id], onDelete: SetNull)
  bookingGuests     BookingGuest[]
  createdAt         DateTime   @default(now())

  @@index([date])
  @@index([unitId, date])
  @@index([tenantId])
  @@index([invoiceId])
  @@index([ownerInvoiceId])
  @@index([type])
  @@index([unitId, type])
}

model ExpenseEntry {
  id                String          @id @default(cuid())
  date              DateTime
  unitId            String?
  propertyId        String?
  scope             ExpenseScope
  category          ExpenseCategory
  amount            Decimal @db.Decimal(14, 2)
  description       String?
  isSunkCost        Boolean         @default(false)
  paidFromPettyCash Boolean         @default(false)
  amountPaid        Decimal           @default(0) @db.Decimal(14, 2)
  dueDate           DateTime?
  vatAmount         Decimal? @db.Decimal(14, 2)
  paymentMethod     PaymentMethod?
  paymentReference  String?
  paymentDate       DateTime?
  // INFORMATIONAL ONLY — the value of a discount received from the vendor.
  // `amount` is ALREADY net-of-discount (what was actually charged, pre-VAT);
  // this is never subtracted from `amount` and never enters any total.
  // List price for reporting = amount + discountAmount (reconstructed, not stored).
  discountAmount    Decimal?        @db.Decimal(14, 2)
  notes             String?
  vendorId          String?
  // Owning organisation — the ONLY scoping handle for PORTFOLIO rows (no
  // property/unit to resolve through). Stamped on create from the session;
  // null on legacy rows created before 2026-07 (grandfathered as visible).
  organizationId    String?
  // Set when this entry was materialised from a RecurringExpense template
  // (POST /api/recurring-expenses/apply) — drives the "Recurring" origin
  // badge. SetNull so deleting a template keeps its historical entries.
  recurringExpenseId String?
  // Who entered the row — drives CARETAKER "edit/delete own rows only".
  // NULL on legacy rows (= not owned by anyone; caretakers can never touch them).
  createdByUserId   String?
  createdBy         User?                    @relation("ExpenseCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  unit              Unit?                    @relation(fields: [unitId], references: [id])
  property          Property?                @relation(fields: [propertyId], references: [id])
  vendor            Vendor?                  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  recurringExpense  RecurringExpense?        @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  lineItems         ExpenseLineItem[]
  unitAllocations   ExpenseUnitAllocation[]
  documents         ExpenseDocument[]
  maintenanceLogs   AssetMaintenanceLog[]
  pettyCashEntry    PettyCash?
  vendorPaymentAllocations VendorPaymentAllocation[]
  createdAt         DateTime                 @default(now())

  @@index([date])
  @@index([propertyId, date])
  @@index([unitId])
  @@index([isSunkCost, date])
  @@index([recurringExpenseId])
  @@index([organizationId])
  @@index([createdByUserId])
}

// Unit of measurement for expense line-item quantities — purely descriptive
// context for the qty × rate breakdown (e.g. 3 KG × 800). Never enters any
// calculation. OTHER pairs with ExpenseLineItem.unitOther free-text,
// mirroring the AssetCategory + categoryOther pattern.
enum UnitOfMeasure {
  // Count
  UNIT
  ITEM
  SET
  PAIR
  // Weight
  KG
  G
  TONNE
  // Volume
  LITRE
  ML
  // Length
  M
  MM
  // Area
  M2
  // Labour / time
  HOUR
  DAY
  TRIP
  OTHER
}

model ExpenseLineItem {
  id               String               @id @default(cuid())
  expenseId        String
  category         LineItemCategory
  description      String?
  // Optional per-line charge/service date — one invoice often covers work
  // done on different days. Informational: the PARENT expense's date still
  // decides which month the cost lands in for the P&L and reports.
  date             DateTime?
  amount           Decimal @db.Decimal(14, 2)
  // Optional qty × rate breakdown. When BOTH are present, `amount` is derived
  // as round2(quantity * unitRate) at save time; otherwise `amount` is entered
  // directly. Either way `amount` stays the net figure everything downstream
  // reads — these are just the inputs that produced it, persisted so the row
  // round-trips and stays editable. quantity is Float (fractional allowed,
  // e.g. 2.5 kg) like sizeSqm; unitRate is money.
  quantity         Float?
  unitRate         Decimal?             @db.Decimal(14, 2)
  // Optional unit of measurement for quantity — descriptive only, never in
  // any calculation. unitOther is the free-text used when unit = OTHER
  // (null otherwise), mirroring AssetCategory/categoryOther.
  unit             UnitOfMeasure?
  unitOther        String?
  // INFORMATIONAL ONLY — see ExpenseEntry.discountAmount. Never subtracted
  // from `amount`, never enters totals; VAT was computed on the discounted
  // base (`amount`), so taxAmount needs no adjustment.
  discountAmount   Decimal?             @db.Decimal(14, 2)
  isVatable        Boolean              @default(false)
  taxConfigId      String?
  taxRate          Float?
  taxAmount        Decimal? @db.Decimal(14, 2)
  taxType          TaxType?
  paymentStatus    LineItemPaymentStatus @default(UNPAID)
  amountPaid       Decimal                @default(0) @db.Decimal(14, 2)
  paymentReference String?
  // When this line was (last) paid — items on one invoice are often settled
  // on different dates, so the date lives per line, not on the expense.
  paymentDate      DateTime?
  expense          ExpenseEntry         @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model ExpenseUnitAllocation {
  id          String       @id @default(cuid())
  expenseId   String
  unitId      String
  shareAmount Decimal @db.Decimal(14, 2)
  expense     ExpenseEntry @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  unit        Unit         @relation(fields: [unitId], references: [id])

  @@unique([expenseId, unitId])
}

model PettyCash {
  id              String          @id @default(cuid())
