  // Set when this OUT row mirrors an expense paid from petty cash — the
  // cascade keeps the ledger in sync when the expense is deleted (single,
  // bulk, or delete-all). Historical rows created before the link stay null.
  expenseEntryId  String?         @unique
  expenseEntry    ExpenseEntry?   @relation(fields: [expenseEntryId], references: [id], onDelete: Cascade)
  // Owning organisation — scopes rows with no property (see ExpenseEntry note).
  organizationId  String?
  status          PettyCashStatus @default(APPROVED)
  approvedBy      String?
  approvedAt      DateTime?
  approvalNotes   String?
  rejectedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime        @default(now())

  @@index([propertyId])
  @@index([status])
  @@index([organizationId])
}

model ManagementFeeConfig {
