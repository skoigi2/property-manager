  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([propertyId])
  @@index([warrantyExpiry])
}

/// What a file attached to an asset is — warranty card, manual, service report…
enum AssetDocumentCategory {
  WARRANTY
  MANUAL
  INVOICE_RECEIPT
  SERVICE_REPORT
  CERTIFICATE
  PHOTO
  OTHER
}

model AssetDocument {
  id              String   @id @default(cuid())
  assetId         String
  asset           Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  category        AssetDocumentCategory @default(OTHER)
  label           String
  fileName        String
  /// Storage path inside the private `tenant-documents` bucket (signed on read).
  /// Rows from before 2026-09 hold a public URL in the old `property-documents`
  /// bucket instead — `isLegacyPublicUrl()` in src/lib/document-files.ts.
  fileUrl         String
  fileSize        Int?
  mimeType        String?
  /// The date the document speaks to (service date, invoice date), not the upload date.
  documentDate    DateTime?
  uploadedByEmail String?
  uploadedByName  String?
  uploadedAt      DateTime @default(now())

  @@index([assetId])
}

model AssetMaintenanceSchedule {
  id                 String               @id @default(cuid())
  assetId            String?
  asset              Asset?               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  propertyId         String?
  property           Property?            @relation("PropertyMaintenanceSchedules", fields: [propertyId], references: [id], onDelete: Cascade)
  taskName           String
  description        String?
  frequency          MaintenanceFrequency
  lastDone           DateTime?
  nextDue            DateTime?
  isActive           Boolean              @default(true)
  taskCategory       String?
  estimatedCost      Decimal? @db.Decimal(14, 2)
  recurringExpenseId String?              @unique
  recurringExpense   RecurringExpense?    @relation("ScheduleRecurringExpense", fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  logs               AssetMaintenanceLog[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([assetId])
  @@index([propertyId])
  @@index([recurringExpenseId])
  @@index([nextDue])
}

model AssetMaintenanceLog {
  id          String                    @id @default(cuid())
  assetId     String
  asset       Asset                     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  scheduleId  String?
  schedule    AssetMaintenanceSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  expenseId   String?
  expense     ExpenseEntry?             @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  date        DateTime
  description String
  cost        Decimal? @db.Decimal(14, 2)
  technician  String?
  vendorId    String?
  notes       String?
  vendor      Vendor?                   @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  createdAt   DateTime                  @default(now())

  @@index([assetId])
  @@index([scheduleId])
  @@index([expenseId])
  @@index([vendorId])
}

// ─── Management Agreement ─────────────────────────────────────────────────────

model ManagementAgreement {
  id                             String   @id @default(cuid())
  propertyId                     String   @unique
  property                       Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // Fee rates
  managementFeeRate              Float    @default(8.5)
  vacancyFeeRate                 Float    @default(5.0)
  vacancyFeeThresholdMonths      Int      @default(9)
  newLettingFeeRate              Float    @default(50.0)
  leaseRenewalFeeFlat            Decimal    @default(3000) @db.Decimal(14, 2)
  shortTermLettingFeeRate        Float    @default(10.0)
  repairAuthorityLimit           Decimal    @default(100000) @db.Decimal(14, 2)
  setupFeeTotal                  Decimal? @db.Decimal(14, 2)
  setupFeeInstalments            Int      @default(3)

  // Deadlines
  rentRemittanceDay              Int      @default(5)
  mgmtFeeInvoiceDay              Int      @default(7)
  landlordPaymentDays            Int      @default(2)

  // KPI targets
  kpiStartDate                   DateTime?
  kpiOccupancyTarget             Float    @default(90)
  kpiRentCollectionTarget        Float    @default(90)
  kpiExpenseRatioTarget          Float    @default(85)
  kpiTenantTurnoverTarget        Float    @default(90)
  kpiDaysToLeaseTarget           Int      @default(60)
  kpiRenewalRateTarget           Float    @default(90)
  kpiMaintenanceCompletionTarget Float    @default(95)
  kpiEmergencyResponseHrs        Int      @default(24)
  kpiStandardResponseHrs         Int      @default(96)
  latePaymentInterestRate        Float    @default(0)   // annual %, e.g. 5.0

  // Default payment account for tenant invoices on this property (overridable
  // per unit via Unit.paymentAccountId). The inline tenant* fields below are
  // the legacy storage and remain as the fallback for unmigrated agreements.
  paymentAccountId               String?
  paymentAccount                 PaymentAccount? @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)

  // Tenant invoice payment details (where tenants send rent)
  tenantKraPin                   String?
  tenantBankName                 String?
  tenantBankAccountName          String?
  tenantBankAccountNumber        String?
  tenantBankBranch               String?
  tenantMpesaPaybill             String?
  tenantMpesaAccountNumber       String?
  tenantMpesaTill                String?
  tenantPaymentInstructions      String?

  // Manager billing details (where owner sends management fees)
  mgmtKraPin                     String?
  mgmtBankName                   String?
  mgmtBankAccountName            String?
  mgmtBankAccountNumber          String?
  mgmtBankBranch                 String?
  mgmtMpesaPaybill               String?
  mgmtMpesaAccountNumber         String?
  mgmtMpesaTill                  String?
  mgmtPaymentInstructions        String?

  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  @@index([propertyId])
}

// ─── Payment Accounts ─────────────────────────────────────────────────────────
// Named bank/M-Pesa destinations for rent collection, reusable across
// properties. Invoices resolve: unit override → property default (agreement)
// → legacy inline agreement fields → organisation branding.

model PaymentAccount {
  id                  String   @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                String   // friendly label, e.g. "KCB — Main Collections"
  // Invoicing identity — set when invoices paid to this account are issued by
  // a different company than the organisation (name/logo/tax IDs override the
  // invoice header).
  companyName         String?
  logoUrl             String?
  kraPin              String?  // PIN No.
  vatNumber           String?  // VAT No.
  address             String?
  phone               String?
  email               String?
  // Per-company invoice numbering series — when invoiceFormat is set,
  // invoices resolving to this account are numbered from THIS counter
  // instead of the organisation default.
  invoiceFormat       String?
  invoiceNextNumber   Int      @default(1)
  bankName            String?
  bankAccountName     String?
  bankAccountNumber   String?
  bankBranch          String?
  mpesaPaybill        String?
  mpesaAccountNumber  String?
  mpesaTill           String?
  paymentInstructions String?
  isActive            Boolean  @default(true)
  agreements          ManagementAgreement[]
  units               Unit[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([organizationId])
}

// ─── Building Condition Reports ───────────────────────────────────────────────

model BuildingConditionReport {
  id               String   @id @default(cuid())
  propertyId       String
  property         Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reportDate       DateTime
  inspector        String?
  overallCondition String
  summary          String?
  items            Json?
  nextReviewDate   DateTime?
  createdAt        DateTime @default(now())

  @@index([propertyId])
  @@index([reportDate])
}

// ─── Airbnb Guest Management ──────────────────────────────────────────────────

model AirbnbGuest {
  id             String          @id @default(cuid())
  name           String
  email          String?
  phone          String?
  nationality    String?
  passportNumber String?
  preferences    String?
  // Owning organisation — the scoping handle for guest records (the model has
  // no property link of its own). Stamped on create from the session; legacy
  // rows are backfilled through their bookings' property and any that remain
  // null (guests with no booking yet) are grandfathered as visible.
  organizationId String?
  bookings       BookingGuest[]
  documents      GuestDocument[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([name])
  @@index([email])
  @@index([organizationId])
}

model BookingGuest {
  id            String      @id @default(cuid())
  guestId       String
  incomeEntryId String
  isPrimary     Boolean     @default(false)
  guest         AirbnbGuest @relation(fields: [guestId], references: [id], onDelete: Cascade)
  incomeEntry   IncomeEntry @relation(fields: [incomeEntryId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([guestId, incomeEntryId])
  @@index([incomeEntryId])
  @@index([guestId])
}

model GuestDocument {
  id          String      @id @default(cuid())
  guestId     String
  label       String
  fileName    String
  storagePath String
  fileSize    Int?
  mimeType    String?
  uploadedAt  DateTime    @default(now())
  guest       AirbnbGuest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([guestId])
}

model Agent {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  phone          String?
  email          String?
  agency         String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([name])
  @@index([organizationId])
}

// ─── Vendor Registry ──────────────────────────────────────────────────────────

model Vendor {
  id             String         @id @default(cuid())
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id])
  name           String
  category       VendorCategory @default(OTHER)
  phone          String?
  email          String?
  taxId          String?           @map("kraPin")
  bankDetails    String?
  notes          String?
  isActive       Boolean        @default(true)
  expenses        ExpenseEntry[]
  maintenanceJobs MaintenanceJob[]
  assetLogs       AssetMaintenanceLog[]
  recurringExpenses RecurringExpense[]
  assets          Asset[]
  payments        VendorPayment[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId])
  @@index([name])
}

// One real-world remittance to a vendor (cheque / M-Pesa / transfer). A single
// payment may settle many ExpenseEntry rows — possibly across properties — via
// VendorPaymentAllocation. Org-scoped (nullable like Vendor.organizationId:
// null = legacy/super-admin rows, grandfathered visible per the property-less
// financial-row rules).
model VendorPayment {
  id             String        @id @default(cuid())
  organizationId String?
  vendorId       String
  paymentDate    DateTime
  amount         Decimal       @db.Decimal(14, 2)
  paymentMethod  PaymentMethod
  reference      String?       // cheque / M-Pesa number
  notes          String?
  vendor         Vendor        @relation(fields: [vendorId], references: [id])
  allocations    VendorPaymentAllocation[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@index([vendorId, paymentDate])
}

// Applies part of a VendorPayment against one ExpenseEntry. Sum of a payment's
// allocations must be <= payment.amount (remainder = unallocated credit on the
// vendor account). Once an expense has allocations, SUM(allocations.amount) is
// the source of truth for its amountPaid (routes recompute it on every
// allocation create/update/delete). Expense delete cascades the allocation
// away — the payment then simply carries more unallocated credit.
model VendorPaymentAllocation {
  id              String        @id @default(cuid())
  vendorPaymentId String
  expenseEntryId  String
  amount          Decimal       @db.Decimal(14, 2)
  vendorPayment   VendorPayment @relation(fields: [vendorPaymentId], references: [id], onDelete: Cascade)
  expenseEntry    ExpenseEntry  @relation(fields: [expenseEntryId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([vendorPaymentId, expenseEntryId])
  @@index([expenseEntryId])
}

// ─── Tax Engine ───────────────────────────────────────────────────────────────

enum TaxType {
  ADDITIVE  // VAT, GST — added on top of amount; increases invoice total
  WITHHELD  // WHT, TDS — deducted from gross before remittance to owner/vendor
}

model TaxConfiguration {
  id            String    @id @default(cuid())
  orgId         String
  propertyId    String?                       // null = org-level default for all properties
  label         String                        // e.g. "VAT", "WHT", "GST", "TDS", "Tourism Levy"
  rate          Float                         // decimal: 0.16 = 16%
  type          TaxType
  appliesTo     String[]                      // e.g. ["LONGTERM_RENT", "CONTRACTOR_LABOUR"]
  isInclusive   Boolean   @default(false)     // true = stated amount already includes tax
  isActive      Boolean   @default(true)
  effectiveFrom DateTime  @default(now())     // rate-change history
  createdAt     DateTime  @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  property Property?    @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([propertyId])
  @@index([orgId, isActive])
}

// ─── Compliance Certificates ─────────────────────────────────────────────────

model ComplianceCertificate {
  id                  String        @id @default(cuid())
  organizationId      String?
  propertyId          String
  certificateType     String        // free-text: "Gas Safety", "EPC", "HMO License", etc.
  certificateNumber   String?
  issuedBy            String?
  issueDate           DateTime
  expiryDate          DateTime?     // null = ongoing / no expiry
  notes               String?
  documentStoragePath String?
  property            Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  organization        Organization? @relation(fields: [organizationId], references: [id])
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([propertyId])
  @@index([organizationId])
  @@index([expiryDate])
}

// ─── Automated Notifications ─────────────────────────────────────────────────

enum NotificationType {
  LEASE_EXPIRY_30D
  LEASE_EXPIRY_7D
  INVOICE_OVERDUE
  COMPLIANCE_EXPIRY_30D
  COMPLIANCE_EXPIRY_7D
  INSURANCE_EXPIRY_30D
  INSURANCE_EXPIRY_7D
  WARRANTY_EXPIRY_30D
  WARRANTY_EXPIRY_7D
  MAINTENANCE_URGENT_OPEN
  OWNER_MONTHLY_REPORT
  TENANT_RENT_REMINDER
}

model NotificationLog {
  id             String           @id @default(cuid())
  organizationId String
  type           NotificationType
  resourceId     String
  resourceType   String
  recipientEmail String
  subject        String
  sentAt         DateTime         @default(now())

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([type, resourceId, sentAt])
  @@index([organizationId, sentAt])
}

// ─── Communication Log ───────────────────────────────────────────────────────

enum CommunicationType {
  EMAIL
}

model CommunicationLog {
  id                String            @id @default(cuid())
  tenantId          String
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type              CommunicationType
  subject           String
  body              String?
  templateUsed      String?
  loggedByEmail     String
  loggedByName      String?
  sentAt            DateTime          @default(now())
  followUpDate      DateTime?
  followUpCompleted Boolean           @default(false)
  caseThreadId      String?
  caseThread        CaseThread?       @relation(fields: [caseThreadId], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now())

  @@index([tenantId, sentAt])
  @@index([caseThreadId])
}

// ─── Portal Messaging (two-way tenant ↔ manager) ─────────────────────────────

model PortalMessageThread {
  id            String                @id @default(cuid())
  tenantId      String
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subject       String
  category      PortalMessageCategory
  status        PortalThreadStatus    @default(SENT)
  lastMessageAt DateTime              @default(now())
  // Set when a manager logs this chat thread as a formal complaint
  // (POST .../messages/[threadId]/convert-to-complaint). One-way, once.
  complaintId   String?               @unique
  complaint     TenantComplaint?      @relation("ComplaintSourceThread", fields: [complaintId], references: [id], onDelete: SetNull)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  messages      PortalMessage[]

  @@index([tenantId, lastMessageAt])
  @@index([status])
}

model PortalMessage {
  id              String              @id @default(cuid())
  threadId        String
  thread          PortalMessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  body            String
  sender          PortalMessageSender
  authorUserId    String?
  readByManagerAt DateTime?
  readByTenantAt  DateTime?
  createdAt       DateTime            @default(now())

  @@index([threadId, createdAt])
}

// ─── SaaS Billing Enum ────────────────────────────────────────────────────────

enum PricingTier {
  TRIAL
  STARTER
  GROWTH
  PRO
}

// ─── Org Invitations ─────────────────────────────────────────────────────────

// SENT = live invitation (email delivered, token accepts). REQUESTED = created
// by a MANAGER and awaiting admin approval — the token is inert until an admin
// approves, which flips it to SENT and emails the invitee.
enum OrgInvitationStatus {
  REQUESTED
  SENT
}

model OrgInvitation {
  id              String       @id @default(cuid())
  email           String
  role            UserRole
  organizationId  String
  invitedByUserId String
  token           String       @unique @default(cuid())
  status          OrgInvitationStatus @default(SENT)
  // Property scope granted on acceptance for MANAGER/ACCOUNTANT invitees.
  // Empty = all org properties (legacy behaviour).
  propertyIds     String[]     @default([])
  expiresAt       DateTime
  acceptedAt      DateTime?
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy       User         @relation("SentInvitations", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())

  @@index([token])
  @@index([organizationId])
  @@index([email])
}

// ─── Email Log (super-admin outbound email history) ──────────────────────────

enum EmailKind {
  PASSWORD_RESET
  ORG_INVITATION
  CONTACT_FORM
  CONTACT_AUTOREPLY
  NEW_USER_ALERT
  WELCOME
  NOTIFICATION
  MANUAL
}

model EmailLog {
  id             String    @id @default(cuid())
  kind           EmailKind
  fromEmail      String
  toEmail        String
  replyTo        String?
  subject        String
  bodyHtml       String    @db.Text
  bodyText       String?   @db.Text
  resendId       String?
  status         String    @default("sent")
  errorMessage   String?
  organizationId String?
  userId         String?
  inReplyToId    String?
  caseThreadId   String?
  sentAt         DateTime  @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  inReplyTo    EmailLog?     @relation("EmailReplies", fields: [inReplyToId], references: [id], onDelete: SetNull)
  replies      EmailLog[]    @relation("EmailReplies")
  caseThread   CaseThread?   @relation(fields: [caseThreadId], references: [id], onDelete: SetNull)

  @@index([sentAt])
  @@index([toEmail])
  @@index([kind])
  @@index([organizationId])
  @@index([userId])
  @@index([inReplyToId])
  @@index([caseThreadId])
}

// ─── Checkout / Move-Out ─────────────────────────────────────────────────────

model CheckoutProcess {
  id                    String         @id @default(cuid())
  tenantId              String         @unique
  unitId                String
  propertyId            String
  organizationId        String?
  checkOutDate          DateTime
  damageFound           Boolean        @default(false)
  inventoryDamageAmount Decimal          @default(0) @db.Decimal(14, 2)
  inventoryDamageNotes  String?
  damageKeptByLandlord  Boolean        @default(true)
  rentBalanceOwing      Decimal          @default(0) @db.Decimal(14, 2)
  rentBalanceSource     String?
  originalDeposit       Decimal @db.Decimal(14, 2)
  // Sum of DEPOSIT income receipts at finalize time. Null = no receipt trail
  // existed (settlement fell back to the contractual originalDeposit).
  depositReceived       Decimal? @db.Decimal(14, 2)
  totalDeductions       Decimal          @default(0) @db.Decimal(14, 2)
  balanceToRefund       Decimal          @default(0) @db.Decimal(14, 2)
  keysReturned          Json?
  utilityTransfers      Json?
  refundMethod          RefundMethod?
  refundDetails         Json?
  notes                 String?
  status                CheckoutStatus @default(IN_PROGRESS)
  finalizedAt           DateTime?
  finalizedByUserId     String?
  pdfGeneratedAt        DateTime?
  // Tenant e-sign acknowledgment (typed-name magic link, mirrors /approve).
  signatureToken          String?   @unique
  signatureTokenExpiresAt DateTime?
  signatureRequestedAt    DateTime?
  tenantSignedName        String?
  tenantSignedAt          DateTime?
  expenseEntryId        String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit         Unit                @relation(fields: [unitId], references: [id])
  property     Property            @relation(fields: [propertyId], references: [id])
  organization Organization?       @relation(fields: [organizationId], references: [id])
  deductions   CheckoutDeduction[]

  @@index([propertyId])
  @@index([unitId])
  @@index([status])
}

model CheckoutDeduction {
  id          String                    @id @default(cuid())
  checkoutId  String
  description String
  amount      Decimal @db.Decimal(14, 2)
  category    CheckoutDeductionCategory @default(OTHER)
  createdAt   DateTime                  @default(now())

  checkout    CheckoutProcess           @relation(fields: [checkoutId], references: [id], onDelete: Cascade)

  @@index([checkoutId])
}

// ─── Condition Reports / Move-In Checklist ───────────────────────────────────

model ConditionReport {
  id               String              @id @default(cuid())
  unitId           String
  propertyId       String
  tenantId         String?
  organizationId   String?
  reportDate       DateTime
  reportType       ConditionReportType
  items            Json                @default("[]")
  overallComments  String?
  signedByTenant   Boolean             @default(false)
  signedByManager  Boolean             @default(false)
  tenantDocumentId String?             @unique
  pdfGeneratedAt   DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  unit         Unit                   @relation(fields: [unitId], references: [id])
  property     Property               @relation(fields: [propertyId], references: [id])
  tenant       Tenant?                @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  organization Organization?          @relation(fields: [organizationId], references: [id])
  photos       ConditionReportPhoto[]

  @@index([unitId])
  @@index([tenantId])
  @@index([propertyId, reportType])
  @@index([reportType])
}

model ConditionReportPhoto {
  id          String          @id @default(cuid())
  reportId    String
  storagePath String
  fileName    String
  mimeType    String
  fileSize    Int
  uploadedAt  DateTime        @default(now())

  report      ConditionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

// ─── Public API & Webhooks ─────────────────────────────────────────────────────

model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  /// sha256 hex of the raw key — the raw value is shown once at creation
  keyHash        String       @unique
  /// display prefix, e.g. "gwpm_a1b2c3d4" so users can identify keys
  keyPrefix      String
  createdByEmail String?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model WebhookEndpoint {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  url            String
  /// HMAC-SHA256 signing secret — shown once at creation
  secret         String
  /// subscribed event names, e.g. ["invoice.paid"]
  events         String[]
  isActive       Boolean      @default(true)
  lastSuccessAt  DateTime?
  lastFailureAt  DateTime?
  failureCount   Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}
