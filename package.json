{
  "name": "property-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "tutorials:record": "tsx scripts/record-tutorials/run.ts",
    "demo:smoke": "tsx scripts/demo-smoke.ts",
    "prod": "tsx scripts/with-prod.ts",
    "db:drift": "tsx scripts/schema-drift.ts",
    "data:health": "tsx scripts/data-health.ts",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "ts-node -P tsconfig.seed.json prisma/seed.ts",
    "db:seed:demo": "ts-node -P tsconfig.seed.json prisma/seed-demo.ts",
    "db:seed:mayfair": "ts-node -P tsconfig.seed.json prisma/seed-mayfair.ts",
    "db:seed:bahrain": "ts-node -P tsconfig.seed.json prisma/seed-bahrain.ts",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "cases:backfill": "ts-node -P tsconfig.seed.json scripts/backfill-cases.ts",
    "cases:backfill-stages": "ts-node -P tsconfig.seed.json scripts/backfill-case-stages.ts",
    "cases:backfill-invoice-links": "ts-node -P tsconfig.seed.json scripts/backfill-invoice-case-links.ts",
    "cases:backfill-terminal-reasons": "ts-node -P tsconfig.seed.json scripts/backfill-case-terminal-reasons.ts",
    "arrears:consolidate": "ts-node -P tsconfig.scripts.json -r tsconfig-paths/register scripts/consolidate-arrears-cases.ts",
    "statements:diagnose": "ts-node -P tsconfig.seed.json scripts/diagnose-statement-data.ts",
    "statements:backfill-links": "ts-node -P tsconfig.seed.json scripts/backfill-income-tenant-links.ts",
    "statements:heal-orphans": "ts-node -P tsconfig.seed.json scripts/heal-paid-invoice-income.ts"
  },
  "prisma": {
    "seed": "ts-node -P tsconfig.seed.json prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@auth/prisma-adapter": "^2.11.1",
    "@hookform/resolvers": "^5.9.1",
    "@paddle/paddle-js": "^1.6.2",
    "@prisma/client": "^5.22.0",
    "@react-pdf/renderer": "^4.3.2",
    "@sentry/nextjs": "^10.57.0",
    "@supabase/supabase-js": "^2.99.3",
    "@tailwindcss/typography": "^0.5.19",
    "@types/jszip": "^3.4.0",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "docx": "^9.6.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "next": "15.5.27",
    "next-auth": "^5.0.0-beta.30",
    "next-pwa": "^5.6.0",
    "prisma": "^5.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.72.0",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.8.0",
    "resend": "^6.10.0",
    "stripe": "^22.0.1",
    "tailwind-merge": "^3.5.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.27",
    "playwright": "^1.59.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
