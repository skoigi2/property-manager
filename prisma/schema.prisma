// ─── Automations ─────────────────────────────────────────────────────────────
// Predefined, toggleable workflow templates per organization. When enabled, the
// daily cron (runAutomations) auto-creates Cases for the matching condition.
model AutomationTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String // e.g. "LEASE_RENEWAL_90D"
  name           String
  description    String
  enabled        Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
}

// Write-once dedup ledger — one row per (automationKey, subjectId) ensures an
// automation never fires twice for the same underlying record.
model AutomationExecution {
  id             String   @id @default(cuid())
  organizationId String
  automationKey  String
  subjectId      String
  executedAt     DateTime @default(now())

  @@unique([automationKey, subjectId])
  @@index([organizationId])
}

// Optional per-property override of an org-level automation toggle. When a row
// exists for (automationKey, propertyId) it wins over the org default; absence
// means "inherit the organisation setting". Scalar FKs (cascade enforced in SQL)
// mirror AutomationExecution.
model AutomationPropertyOverride {
  id             String   @id @default(cuid())
  organizationId String
  automationKey  String
  propertyId     String
  enabled        Boolean
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([automationKey, propertyId])
  @@index([organizationId])
  @@index([propertyId])
}

