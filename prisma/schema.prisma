// ─── Asset Register ───────────────────────────────────────────────────────────

model Asset {
  id              String        @id @default(cuid())
  propertyId      String
  property        Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId          String?
  unit            Unit?         @relation(fields: [unitId], references: [id])
  name            String
  category        AssetCategory
  categoryOther   String?
  serialNumber    String?
  modelNumber     String?
  purchaseDate    DateTime?
  purchaseCost    Decimal? @db.Decimal(14, 2)
  /// What it would cost to replace today — what a contents policy should cover.
  replacementValue Decimal? @db.Decimal(14, 2)
  /// Set when the asset is retired / sold / scrapped. Disposed assets keep their
  /// history but drop out of KPIs, alerts, the calendar and the contents check.
  disposedAt      DateTime?
  disposalNotes   String?
  warrantyExpiry  DateTime?
  serviceProvider String?
  serviceContact  String?
  vendorId        String?
  notes           String?
  vendor               Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
