// Property Manager — Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Organisation (multi-tenancy) ────────────────────────────────────────────

model Organization {
  id              String                       @id @default(cuid())
  name            String
  logoUrl         String?
  address         String?
  phone           String?
  email           String?
  website         String?
  isActive              Boolean                      @default(true)
  locale                String                       @default("en-US")
  defaultCurrency       String                       @default("USD")
  vatRegistrationNumber String?
  // Invoice numbering — org default series. Format tokens: {YYYY} {YY} {MM}
  // {YYYYMM} {SEQ}. Null = "INV-{YYYYMM}-{SEQ}". Counter increments atomically
  // per allocation (see src/lib/invoice-numbering.ts).
  invoiceFormat         String?
  invoiceNextNumber     Int     @default(1)
  bankName              String?
  bankAccountName       String?
  bankAccountNumber     String?
  bankBranch            String?
  mpesaPaybill          String?
  mpesaAccountNumber    String?
  mpesaTill             String?
  paymentInstructions   String?
  // ── SaaS billing ──────────────────────────────────────────────────────────
  pricingTier           PricingTier                  @default(TRIAL)
  trialEndsAt           DateTime?
  subscriptionStatus    String?                      // "trialing"|"active"|"past_due"|"canceled"
  currentPeriodEnd      DateTime?
  paddleCustomerId      String?
  paddleSubscriptionId  String?
  paddleEventId         String?                      // last processed webhook event (idempotency)
  freeAccess            Boolean                      @default(false) // super-admin complimentary override
  users                 User[]
  properties            Property[]
  memberships           UserOrganizationMembership[]
  vendors                Vendor[]
  paymentAccounts        PaymentAccount[]
  taxConfigurations      TaxConfiguration[]
  complianceCertificates ComplianceCertificate[]
  notificationLogs       NotificationLog[]
  emailLogs              EmailLog[]
  invitations            OrgInvitation[]
  agents                 Agent[]
  caseThreads            CaseThread[]
  actionableHints        ActionableHint[]
  automationTemplates    AutomationTemplate[]
  complaints             TenantComplaint[]
  apiKeys                ApiKey[]
  webhookEndpoints       WebhookEndpoint[]
  checkouts              CheckoutProcess[]
  conditionReports       ConditionReport[]
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
}

model UserOrganizationMembership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           UserRole     @default(MANAGER)
  isBillingOwner Boolean      @default(false)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

// ─── Auth (NextAuth / Auth.js) ────────────────────────────────────────────────

enum UserRole {
  ADMIN
  OWNER
  MANAGER
  ACCOUNTANT
  CARETAKER
}

model User {
  id               String           @id @default(cuid())
  name             String?
  email            String?          @unique
  emailVerified    DateTime?
  image            String?
  password             String?
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?
  role             UserRole         @default(MANAGER)
  phone            String?
  isActive         Boolean          @default(true)
  organizationId          String?
  organization            Organization?                @relation(fields: [organizationId], references: [id])
  organizationMemberships UserOrganizationMembership[]
  propertyAccess          PropertyAccess[]
  ownedProperties   Property[]       @relation("PropertyOwner")
  managedProperties Property[]       @relation("PropertyManager")
  ownerInvoices     OwnerInvoice[]   @relation("OwnerInvoices")
  sentInvitations  OrgInvitation[]  @relation("SentInvitations")
  emailLogs        EmailLog[]
  caseAssignments  CaseThread[]     @relation("CaseAssignee")
  caseEvents       CaseEvent[]      @relation("CaseEventActor")
  raisedComplaints TenantComplaint[] @relation("ComplaintRaisedBy")
  approvalRequests ApprovalRequest[] @relation("ApprovalRequester")
  accounts         Account[]
  sessions         Session[]
  notificationPreferences NotificationPreference[]
  calendarFeedTokens      CalendarFeedToken[]
  calendarEventSnoozes    CalendarEventSnooze[]
  createdExpenses         ExpenseEntry[]  @relation("ExpenseCreatedBy")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([organizationId])
}

// Subscribe-by-URL token for the read-only calendar ICS feed. Deliberately has
// NO expiry column: a subscription that silently stops updating is worse than
// one that never existed, because the manager keeps trusting a stale calendar.
// Access is ended explicitly via `revokedAt` (rotate = revoke + create).
//
// `propertyIds` empty = every property the owning user can access, resolved
// live on each fetch, so revoking someone's PropertyAccess also narrows their
// existing feed.
// Per-user "not now" on a calendar event. Keyed on CalendarEvent.id — the
// stable `{TYPE}-{refId}` string — which is precisely why that id must never
// be randomised. `until` null means dismissed indefinitely.
//
// Per-user, not per-org: one manager deciding a renewal is next month's
// problem must not hide it from a colleague.
model CalendarEventSnooze {
  id        String    @id @default(cuid())
  userId    String
  eventId   String
  until     DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
}

model CalendarFeedToken {
  id             String    @id @default(cuid())
  userId         String
  token          String    @unique @default(uuid())
  propertyIds    String[]
  label          String
  createdAt      DateTime  @default(now())
  lastAccessedAt DateTime?
  revokedAt      DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// Per-user opt-out of automation emails by category. Sparse: a row exists only
// when a user changes a default. Absence = opted in (emailEnabled true). The
// category strings mirror AutomationCategory ("NOTIFICATION" | "WORKFLOW");
// REMINDER is Inbox-only and never a preference target.
model NotificationPreference {
  id           String   @id @default(cuid())
  userId       String
  category     String
  emailEnabled Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

